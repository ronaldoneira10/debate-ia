# Cada pantalla/IA usa SU PROPIA API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY_IZQUIERDA=api_key_de_la_pantalla_izquierda
GEMINI_API_KEY_DERECHA=api_key_de_la_pantalla_derecha

# Opcional: key para el jurado. Si no la pones, usa la de la izquierda.
# GEMINI_API_KEY_JUEZ=api_key_del_jurado

# Opcional: key de respaldo si a un lado no le pones la suya.
# GEMINI_API_KEY=api_key_general

PORT=3000
# Opcionales
GEMINI_MODEL=gemini-3.6-flash
NUM_RONDAS=3
# Largo máximo de cada argumento (en palabras)
MAX_PALABRAS=35
